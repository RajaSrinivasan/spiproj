--  STM32F4 Discovery (STM32F407VG) SPI2 project: microSD and BME280.
--  The application images are linked in the upper flash window. The
--  bootloader is the separate project bootloader.gpr.
--
--  Ada_Drivers_Library is the git submodule at lib/Ada_Drivers_Library.
--
--  The runtime's default linker script pins flash at 0x08000000, so this
--  build passes -XLOADER=USER and supplies ld/app_rom.ld:
--
--    gprbuild -P spiproj.gpr -XLOADER=USER
--
--  Requires the arm-eabi GNAT runtime "embedded-stm32f4".

with "lib/Ada_Drivers_Library/boards/stm32f407_discovery/stm32f407_discovery_full.gpr";

project Spiproj is
   for Runtime ("Ada") use STM32F407_Discovery_Full'Runtime ("Ada");
   for Target use "arm-eabi";
   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Object_Dir use "obj/app";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   for Main use
     ("weather_logger.adb", "demo_spi2.adb", "read_bme280_id.adb");

   package Compiler renames STM32F407_Discovery_Full.Compiler;

   package Linker is
      for Default_Switches ("Ada") use
        ("-Wl,-T,../../ld/app_rom.ld",
         "-Wl,-T,../../ld/section_symbols.ld",
         "-Wl,--gc-sections");
   end Linker;
end Spiproj;
