--  STM32F4 Discovery (STM32F407VG) SPI2 project: microSD and BME280,
--  plus a bootloader that can replace the application from an SD card.
--
--  Ada_Drivers_Library is the git submodule at lib/Ada_Drivers_Library
--  (https://github.com/AdaCore/Ada_Drivers_Library). To use a checkout
--  somewhere else, change the with path below so it points at that tree's
--  boards/stm32f407_discovery/stm32f407_discovery_full.gpr.
--
--  The runtime's default linker script pins flash at 0x08000000 for the
--  whole megabyte. Both images here supply their own script, so the build
--  must select the runtime's USER loader or the two scripts both define
--  a region named flash and the link fails:
--
--    gprbuild -P spiproj.gpr -XLOADER=USER
--    gprbuild -P spiproj.gpr -XLOADER=USER -XIMAGE=boot
--
--  IMAGE=app (the default) links weather_logger, demo_spi2, and
--  read_bme280_id at the application window. IMAGE=boot links the
--  bootloader at the start of flash. See ld/layout_symbols.ld.
--
--  Requires the arm-eabi GNAT runtime "embedded-stm32f4".

with "lib/Ada_Drivers_Library/boards/stm32f407_discovery/stm32f407_discovery_full.gpr";

project Spiproj is
   type Image_Kind is ("app", "boot");
   Image : Image_Kind := external ("IMAGE", "app");

   for Runtime ("Ada") use STM32F407_Discovery_Full'Runtime ("Ada");
   for Target use "arm-eabi";
   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";

   --  The link runs with the object directory as its cwd, so a script
   --  path is relative to obj/app or obj/boot.
   case Image is
      when "app" =>
         for Object_Dir use "obj/app";
         for Main use
           ("weather_logger.adb", "demo_spi2.adb", "read_bme280_id.adb");
      when "boot" =>
         for Object_Dir use "obj/boot";
         for Main use ("bootloader.adb");
   end case;

   package Compiler renames STM32F407_Discovery_Full.Compiler;

   Linker_Script := "../../ld/app_rom.ld";
   case Image is
      when "app" =>
         Linker_Script := "../../ld/app_rom.ld";
      when "boot" =>
         Linker_Script := "../../ld/boot_rom.ld";
   end case;

   package Linker is
      --  --gc-sections drops unused library routines. Without it the
      --  bootloader does not fit in the 384 KiB window.
      for Default_Switches ("Ada") use
        ("-Wl,-T," & Linker_Script,
         "-Wl,-T,../../ld/section_symbols.ld",
         "-Wl,--gc-sections");
   end Linker;

   --  The bootloader's FAT and flash paths use more secondary stack than
   --  the runtime's 512-byte default. The application keeps that default.
   Binder_Switches := ();
   case Image is
      when "boot" =>
         Binder_Switches := ("-D8192");
      when "app" =>
         null;
   end case;

   package Binder is
      for Default_Switches ("Ada") use Binder_Switches;
   end Binder;
end Spiproj;
